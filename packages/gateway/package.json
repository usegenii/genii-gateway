{
	"name": "@usegenii/gateway",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
